{
  "name": "my-literary-journey",
  "private": true,
  "version": "0.1.0",
  "description": "A Great Books digital portfolio presented as a personal notebook.",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "theme": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check",
    "predev": "npm run theme",
    "dev": "node scripts/start-dev.mjs",
    "typecheck": "tsc -b",
    "prebuild": "npm run theme",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run theme:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.2.0",
    "page-flip": "2.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-pageflip": "2.0.3",
    "react-router": "^7.18.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rough-notation": "0.5.1",
    "sketchbook-ui": "1.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.1.0"
  }
}
